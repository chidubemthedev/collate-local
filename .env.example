DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
# Direct (non-pooler) connection for pg-boss (both app and worker).
# On Neon, remove "-pooler" from the hostname to get the direct URL.
# Used by lib/queue/index.ts and worker/index.ts. Falls back to DATABASE_URL.
QUEUE_DATABASE_URL=
DATABASE_SSL=false
NODE_ENV=development
ALLOW_DEMO_SEED=true
BREVO_API_KEY=
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
SERVER_BASE_URL=http://localhost:3000
# Telegram bot token from BotFather; never commit a real token.
TELEGRAM_BOT_TOKEN=replace-with-bot-token
# Telegram bot username, with or without the leading @.
TELEGRAM_BOT_USERNAME=replace-with-bot-username
# Webhook secret: 16-256 characters using letters, numbers, underscores, or hyphens.
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
# Optional: shown in the consent message when set.
PRIVACY_POLICY_URL=
# Never sends Telegram messages when true. Refused when NODE_ENV=production.
TELEGRAM_DRY_RUN=false
# Per-process Telegram send rate. Run exactly one worker process for sends.
TELEGRAM_MAX_PER_SECOND=25
# SMS fallback provider. Only "none" is implemented for now.
SMS_PROVIDER=none
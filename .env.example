DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_SSL=false
NODE_ENV=development
ALLOW_DEMO_SEED=true
BREVO_API_KEY=
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
SERVER_BASE_URL=http://localhost:3000
# Telegram bot token from BotFather; never commit a real token.
TELEGRAM_BOT_TOKEN=replace-with-bot-token
# Telegram bot username, with or without the leading @.
TELEGRAM_BOT_USERNAME=replace-with-bot-username
# Webhook secret: 16-256 characters using letters, numbers, underscores, or hyphens.
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
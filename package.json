{
  "name": "collate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "db:migrate": "tsx ./node_modules/typeorm/cli.js migration:run -d lib/db/data-source.ts",
    "db:migrate:revert": "tsx ./node_modules/typeorm/cli.js migration:revert -d lib/db/data-source.ts",
    "db:migrate:generate": "tsx ./node_modules/typeorm/cli.js migration:generate -d lib/db/data-source.ts",
    "db:migrate:create": "tsx ./node_modules/typeorm/cli.js migration:create",
    "db:seed": "tsx ./lib/db/seeds/index.ts",
    "db:seed:demo": "tsx ./lib/db/seeds/demo/index.ts",
    "db:seed:demo:reset": "tsx ./lib/db/seeds/demo/reset.ts",
    "db:seed:demo:fresh": "tsx ./lib/db/seeds/demo/reset.ts && tsx ./lib/db/seeds/demo/index.ts",
    "worker": "tsx worker/index.ts",
    "worker:dev": "tsx --watch worker/index.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.1",
    "dotenv": "^18.0.9",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^1.65.0",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "reflect-metadata": "^0.2.2",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^1.6.0"
  }
}
